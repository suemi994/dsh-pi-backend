{
  "$schema": "urn:dsh-std:community-draft:dsh-plugin:0.15",
  "manifestVersion": "0.15",
  "id": "com.suemi.pi-backend",
  "name": "Pi Backend for dsh-tui",
  "version": "0.2.2",
  "facets": { "host": { "entry": "register.js", "apiVersion": "v1alpha1" } },
  "requires": { "contracts": [] },
  "permissions": [],
  "contributes": {
    "commands": [],
    "x-dsh-tui": [{
      "apiVersion": "tui.dsh/v1alpha1",
      "kind": "Backend",
      "id": "com.suemi.pi-backend",
      "name": "pi_backend",
      "spec": {
        "id": "pi",
        "label": { "text": "Pi" },
        "shortLabel": "Pi",
        "product": "pi",
        "capabilities": ["permissions", "questions", "models", "effort", "compact", "sideQuery", "commands", "context", "images", "rename", "fork", "rewind", "workingActivity"],
        "grants": [],
        "confirmation": { "policy": "confirm" }
      }
    }]
  },
  "subscriptions": [],
  "license": "ISC"
}
