      "id": "com.suemi.pi-cli-backend",
      "name": "pi_cli_backend",
      "spec": {
        "id": "pi-cli",
        "label": { "text": "Pi (CLI)" },
        "shortLabel": "Pi CLI",
        "product": "pi",
        "capabilities": ["models", "effort", "compact"],
        "grants": [],
        "confirmation": { "policy": "confirm" }
      }
    }]
  },
  "subscriptions": [],
  "license": "ISC"
}
